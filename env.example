# Plaid Dashboard → Team Settings → Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox        # sandbox | production (Trial plan uses production keys)

# Postgres connection string (e.g. from Supabase → Project Settings → Database)
DATABASE_URL=

# Used to build the webhook URL Plaid calls — must be a public HTTPS URL.
# In local dev, point this at an ngrok tunnel. In production, your real domain.
APP_URL=http://localhost:3000

# Encrypts the Plaid access_token at rest (see lib/crypto.js).
# Generate with: openssl rand -hex 32
# Losing this key makes every stored access_token unrecoverable — back it
# up somewhere safe (a password manager, not just this file).
TOKEN_ENCRYPTION_KEY=

# Adds item here for handling sign in/out now 
SESSION_TOKEN=

# Basic Auth for the whole app (see middleware.js) — this is a single-user
# app, so this is what stops anyone else from opening your dashboard.
AUTH_USER=
AUTH_PASSWORD=
